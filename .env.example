# Copy to .env (never commit .env) and fill in only what you need.

# Hugging Face token: model downloads (Docling, local VLMs).
HF_TOKEN=

# Hosted models and services (documents leave your machine, usage is billed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
VISION_AGENT_API_KEY=          # LandingAI Agentic Document Extraction

# LLM judge that re-answers every score question (see README): provider anthropic (default) or openai
# PDF_BENCH_JUDGE_PROVIDER=anthropic
# PDF_BENCH_JUDGE_MODEL=
# PDF_BENCH_JUDGE_BASE_URL=      (OpenAI-compatible server)

# Databricks ai_parse_document
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# DATABRICKS_WAREHOUSE_ID=     (or pick the warehouse in the app)
# PDF_BENCH_DATABRICKS_AI_PARSE_VOLUME=/Volumes/main/default/pdf_bench

# OPEN_DOC_ROUTER_API_KEY=     (https://www.opendocrouter.ai/, many parsing models behind one key)

# LLAMA_CLOUD_API_KEY=

# Per-parser options: PDF_BENCH_<PARSER>_<OPTION>, e.g.
# PDF_BENCH_CLAUDE_MODEL=claude-sonnet-5-5
# PDF_BENCH_DOTS_OCR_BASE_URL=http://localhost:8000/v1
# PDF_BENCH_LANDINGAI_ADE_MODEL=dpt-2-20260410
# PDF_BENCH_OCR_LANG=eng+fra
